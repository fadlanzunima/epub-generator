# Telemetri Telegram (opsional) — dipakai oleh api/report.ts (Vercel Edge Function).
# Salin ke `.env` untuk pengembangan lokal (`vercel dev`), dan set nilai yang sama
# di Vercel: Project → Settings → Environment Variables.
# JANGAN commit nilai asli. Tanpa variabel ini, endpoint /api/report no-op (aman).

# Token bot dari @BotFather (format: 123456789:ABC-DEF...).
TELEGRAM_BOT_TOKEN=

# ID chat tujuan (chat pribadi Anda dengan bot, atau ID grup/channel).
# Cara dapat: kirim pesan ke bot, lalu buka
# https://api.telegram.org/bot<TOKEN>/getUpdates dan lihat "chat":{"id":...}.
TELEGRAM_CHAT_ID=
